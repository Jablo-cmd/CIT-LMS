generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  COMPANY_OWNER
  HR_MANAGER
  ADMIN_PERSONNEL
  @@map("user_role")
}
enum EmploymentType {
  PERMANENT
  CONTRACT
  @@map("employment_type")
}
enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  RESIGNED
  DISMISSED
  DECEASED
  @@map("employment_status")
}
enum LeaveCategory {
  ANNUAL
  SICK
  FAMILY_RESPONSIBILITY
  MATERNITY
  PATERNITY_PARENTAL
  UNPAID
  STUDY
  OTHER
  @@map("leave_category")
}
enum LeaveTransactionType {
  DEDUCTION
  ADJUSTMENT
  REVERSAL
  VOID
  @@map("leave_transaction_type")
}
enum DocumentCategory {
  ACADEMIC_QUALIFICATION
  PROFESSIONAL_CERTIFICATE
  TRAINING_CERTIFICATE
  IDENTITY_PERSONAL
  EMPLOYMENT
  OTHER
  @@map("document_category")
}
enum DisciplinaryOutcome {
  PENDING
  NO_ACTION
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
  DISMISSAL
  OTHER
  @@map("disciplinary_outcome")
}
enum RecommendationType {
  COMMENDATION
  PERFORMANCE
  PROMOTION
  OTHER
  @@map("recommendation_type")
}

model User {
  id            String   @id @db.Uuid
  email         String
  fullName      String   @map("full_name")
  role          UserRole
  isActive      Boolean  @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  auditLogs     AuditLog[]
  capturedLeave LeaveTransaction[] @relation("LeaveCapturedBy")
  uploadedDocs  EmployeeDocument[] @relation("DocumentUploadedBy")
  historyEvents EmploymentHistory[] @relation("HistoryRecordedBy")
  overtimeEntries OvertimeEntry[] @relation("OvertimeCapturedBy")
  disciplinaryRecords DisciplinaryRecord[] @relation("DisciplinaryCapturedBy")
  recommendations Recommendation[] @relation("RecommendationCapturedBy")
  leavePoliciesCreated LeavePolicy[] @relation("LeavePolicyCreatedBy")
  @@map("profiles")
}

model Employee {
  id String @id @default(uuid()) @db.Uuid
  employeeNumber     String @unique @map("employee_number")
  firstName          String @map("first_name")
  lastName           String @map("last_name")
  nationality        String?
  photoPath          String? @map("photo_path")
  photoUpdatedAt     DateTime? @map("photo_updated_at")
  addressStreet      String? @map("address_street")
  addressSuburb      String? @map("address_suburb")
  addressCity        String? @map("address_city")
  addressProvince    String? @map("address_province")
  addressPostalCode  String? @map("address_postal_code")
  phone              String?
  email              String?
  employmentType     EmploymentType
  employmentStatus   EmploymentStatus @default(ACTIVE)
  originalHireDate   DateTime @db.Date @map("original_hire_date")
  contractStartDate  DateTime? @db.Date @map("contract_start_date")
  contractEndDate    DateTime? @db.Date @map("contract_end_date")
  departmentId       String? @db.Uuid @map("department_id")
  currentPosition    String? @map("current_position")
  deployedRole       String? @map("deployed_role")
  currentPostingId   String? @db.Uuid @map("current_posting_id")
  workingScheduleId  String? @db.Uuid @map("working_schedule_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  department         Department? @relation(fields: [departmentId], references: [id])
  currentPosting     PostingSite? @relation("CurrentPosting", fields: [currentPostingId], references: [id])
  workingSchedule    WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])
  history            EmploymentHistory[]
  nextOfKin          NextOfKin[]
  documents          EmployeeDocument[]
  leaveTransactions  LeaveTransaction[]
  overtimeEntries    OvertimeEntry[]
  disciplinary       DisciplinaryRecord[]
  recommendations    Recommendation[]
  @@index([lastName, firstName])
  @@index([employmentStatus])
  @@index([currentPosition])
  @@index([currentPostingId])
  @@map("employees")
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  name      String @unique
  isActive  Boolean @default(true) @map("is_active")
  employees Employee[]
  createdAt DateTime @default(now()) @map("created_at")
  @@map("departments")
}

model PostingSite {
  id String @id @default(uuid()) @db.Uuid
  code           String @unique
  name           String
  address        String?
  city           String?
  province       String?
  isHeadOffice   Boolean @default(false) @map("is_head_office")
  isActive       Boolean @default(true) @map("is_active")
  employees      Employee[] @relation("CurrentPosting")
  previousHistory EmploymentHistory[] @relation("PreviousPosting")
  newHistory     EmploymentHistory[] @relation("NewPosting")
  overtime       OvertimeEntry[]
  createdAt      DateTime @default(now()) @map("created_at")
  @@map("posting_sites")
}

model EmploymentHistory {
  id String @id @default(uuid()) @db.Uuid
  employeeId           String @db.Uuid @map("employee_id")
  previousPosition     String? @map("previous_position")
  newPosition          String? @map("new_position")
  previousDeployedRole String? @map("previous_deployed_role")
  newDeployedRole      String? @map("new_deployed_role")
  previousPostingId    String? @db.Uuid @map("previous_posting_id")
  newPostingId         String? @db.Uuid @map("new_posting_id")
  effectiveDate        DateTime @db.Date @map("effective_date")
  recordedAt           DateTime @default(now()) @map("recorded_at")
  reason               String
  managerName          String? @map("manager_name")
  notes                String?
  supportingDocumentId String? @db.Uuid @unique @map("supporting_document_id")
  recordedById         String @db.Uuid @map("recorded_by_id")
  employee             Employee @relation(fields: [employeeId], references: [id])
  previousPosting      PostingSite? @relation("PreviousPosting", fields: [previousPostingId], references: [id])
  newPosting           PostingSite? @relation("NewPosting", fields: [newPostingId], references: [id])
  supportingDocument   EmployeeDocument? @relation("HistoryDocument", fields: [supportingDocumentId], references: [id])
  recordedBy           User @relation("HistoryRecordedBy", fields: [recordedById], references: [id])
  @@index([employeeId, effectiveDate])
  @@map("employment_history")
}

model NextOfKin {
  id String @id @default(uuid()) @db.Uuid
  employeeId   String @db.Uuid @map("employee_id")
  fullName     String @map("full_name")
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean @default(false) @map("is_primary")
  notes        String?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@map("next_of_kin")
}

model EmployeeDocument {
  id String @id @default(uuid()) @db.Uuid
  employeeId      String @db.Uuid @map("employee_id")
  title           String
  category        DocumentCategory
  originalName    String @map("original_name")
  storagePath     String @unique @map("storage_path")
  mimeType        String @map("mime_type")
  sizeBytes       Int @map("size_bytes")
  description     String?
  uploadedAt      DateTime @default(now()) @map("uploaded_at")
  uploadedById    String @db.Uuid @map("uploaded_by_id")
  employee        Employee @relation(fields: [employeeId], references: [id])
  uploadedBy      User @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  historyEvent    EmploymentHistory? @relation("HistoryDocument")
  leaveForms      LeaveTransaction[]
  overtimeFiles   OvertimeEntry[]
  disciplinary    DisciplinaryRecord[]
  recommendations Recommendation[]
  @@map("employee_documents")
}

model WorkingSchedule {
  id String @id @default(uuid()) @db.Uuid
  name        String @unique
  workingDays Int[] @map("working_days")
  description String?
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  employees   Employee[]
  @@map("working_schedules")
}

model PublicHoliday {
  id String @id @default(uuid()) @db.Uuid
  date        DateTime @unique @db.Date
  name        String
  countryCode String @default("ZA") @map("country_code")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([date, countryCode])
  @@map("public_holidays")
}

model LeavePolicy {
  id String @id @default(uuid()) @db.Uuid
  category        LeaveCategory
  name            String
  entitlementDays Decimal? @db.Decimal(7,2) @map("entitlement_days")
  accrualPerMonth Decimal? @db.Decimal(7,3) @map("accrual_per_month")
  employmentType  EmploymentType?
  effectiveFrom   DateTime @db.Date @map("effective_from")
  effectiveTo     DateTime? @db.Date @map("effective_to")
  carryOverLimit  Decimal? @db.Decimal(7,2) @map("carry_over_limit")
  eligibility     String?
  notes           String?
  isActive        Boolean @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  createdById     String? @db.Uuid @map("created_by_id")
  createdBy       User? @relation("LeavePolicyCreatedBy", fields: [createdById], references: [id])
  transactions    LeaveTransaction[]
  @@index([category, effectiveFrom, effectiveTo])
  @@map("leave_policies")
}

model LeaveTransaction {
  id String @id @default(uuid()) @db.Uuid
  employeeId         String @db.Uuid @map("employee_id")
  policyId           String? @db.Uuid @map("policy_id")
  category           LeaveCategory
  type               LeaveTransactionType @default(DEDUCTION)
  firstLeaveDate     DateTime? @db.Date @map("first_leave_date")
  lastLeaveDate      DateTime? @db.Date @map("last_leave_date")
  formSubmissionDate DateTime? @db.Date @map("form_submission_date")
  capturedAt         DateTime @default(now()) @map("captured_at")
  days               Decimal @db.Decimal(7,2)
  balanceBefore      Decimal? @db.Decimal(9,2) @map("balance_before")
  balanceAfter       Decimal? @db.Decimal(9,2) @map("balance_after")
  reason             String?
  referenceNumber    String? @map("reference_number")
  capturedById       String @db.Uuid @map("captured_by_id")
  employee           Employee @relation(fields: [employeeId], references: [id])
  policy             LeavePolicy? @relation(fields: [policyId], references: [id])
  capturedBy         User @relation("LeaveCapturedBy", fields: [capturedById], references: [id])
  documents          EmployeeDocument[]
  @@index([employeeId, category, capturedAt])
  @@unique([employeeId, category, referenceNumber])
  @@map("leave_transactions")
}

model OvertimeEntry {
  id String @id @default(uuid()) @db.Uuid
  employeeId     String @db.Uuid @map("employee_id")
  postingSiteId  String? @db.Uuid @map("posting_site_id")
  workDate       DateTime @db.Date @map("work_date")
  startTime      String @map("start_time")
  finishTime     String @map("finish_time")
  totalHours     Decimal @db.Decimal(6,2) @map("total_hours")
  confirmedBy    String @map("confirmed_by")
  capturedById   String @db.Uuid @map("captured_by_id")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  employee       Employee @relation(fields: [employeeId], references: [id])
  postingSite    PostingSite? @relation(fields: [postingSiteId], references: [id])
  capturedBy     User @relation("OvertimeCapturedBy", fields: [capturedById], references: [id])
  documents      EmployeeDocument[]
  @@index([workDate, employeeId])
  @@map("overtime_entries")
}

model DisciplinaryRecord {
  id String @id @default(uuid()) @db.Uuid
  employeeId    String @db.Uuid @map("employee_id")
  hearingDate   DateTime @db.Date @map("hearing_date")
  matter        String
  finding       String?
  outcome       DisciplinaryOutcome @default(PENDING)
  sanction      String?
  notes         String?
  capturedById  String @db.Uuid @map("captured_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  employee      Employee @relation(fields: [employeeId], references: [id])
  capturedBy    User @relation("DisciplinaryCapturedBy", fields: [capturedById], references: [id])
  documents     EmployeeDocument[]
  @@index([employeeId, hearingDate])
  @@map("disciplinary_records")
}

model Recommendation {
  id String @id @default(uuid()) @db.Uuid
  employeeId  String @db.Uuid @map("employee_id")
  date        DateTime @db.Date
  type        RecommendationType
  description String
  submittedBy String @map("submitted_by")
  capturedById String @db.Uuid @map("captured_by_id")
  comments    String?
  createdAt   DateTime @default(now()) @map("created_at")
  employee    Employee @relation(fields: [employeeId], references: [id])
  capturedBy  User @relation("RecommendationCapturedBy", fields: [capturedById], references: [id])
  documents   EmployeeDocument[]
  @@index([employeeId, date])
  @@map("recommendations")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  userId      String? @db.Uuid @map("user_id")
  action      String
  entityType  String @map("entity_type")
  entityId    String? @db.Uuid @map("entity_id")
  beforeData  Json? @map("before_data")
  afterData   Json? @map("after_data")
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User? @relation(fields: [userId], references: [id])
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
