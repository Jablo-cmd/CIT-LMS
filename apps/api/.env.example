NODE_ENV=development
PORT=4000
DB_POOL_MAX=10
WEB_ORIGIN=http://localhost:3000
# Use the transaction-pooler DSN for Vercel; direct connection is acceptable for local development only.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
COOKIE_SECURE=false
STORAGE_DRIVER=supabase
STORAGE_ROOT=./storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
# The publishable/anon key is safe for public use; backend reads it for Auth API calls.
SUPABASE_ANON_KEY=your-supabase-publishable-or-legacy-anon-key
SUPABASE_STORAGE_BUCKET=cit-lms-documents
MAX_UPLOAD_BYTES=10485760
# Set to true only for an isolated development database; never production.
CIT_LMS_ALLOW_SEED=false
